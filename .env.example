# Este .env fica na RAIZ do projeto (do lado do docker-compose.yml).
# É diferente do backend/.env — o Docker Compose só lê este aqui pra
# resolver as variáveis ${...} usadas dentro do próprio docker-compose.yml
# (como a senha do Postgres). Repita aqui os mesmos valores de PG_* que
# você colocou em backend/.env.

PG_USER=lassa_logistica
PG_PASSWORD=troque_esta_senha
PG_DATABASE=lassa_logistica

VITE_API_BASE_URL=http://localhost:8788/api
