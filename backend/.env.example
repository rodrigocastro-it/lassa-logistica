# --- Banco do WiBi (ERP) — SOMENTE LEITURA ---
# Nunca fazer INSERT/UPDATE/DELETE nesse banco a partir deste sistema.
WIBI_DB_USER=usuario_readonly
WIBI_DB_PASSWORD=senha
WIBI_DB_SERVER=servidor_sql
WIBI_DB_PORT=1433
WIBI_DB_DATABASE=nome_do_banco_wibi

# --- Banco próprio do sistema de logística (PostgreSQL) ---
PG_HOST=postgres
PG_PORT=5432
PG_USER=lassa_logistica
PG_PASSWORD=troque_esta_senha
PG_DATABASE=lassa_logistica

# --- Autenticação ---
JWT_SECRET=troque_por_uma_string_aleatoria_longa

# --- Point Track ---
POINTTRACK_BASE_URL=https://sistema.pointtrack.com.br
POINTTRACK_EMAIL=usuario_pointtrack
POINTTRACK_SENHA=senha_pointtrack

PORT=8788
